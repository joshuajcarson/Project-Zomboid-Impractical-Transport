<?xml version="1.0" encoding="utf-8"?>
<!-- A stilts fall is a drop from a second-storey floor: the game's own hard-landing clip (Bob_FallLanding_HeavyFall, face down) instead of the stumble.
     Same conditions as vanilla's walkBumpFallFront plus StiltsActive and a higher priority; ImpracticalTransport.stumble() adds the pain and the endurance cost. -->
<animNode>
	<m_Name>fall_stilts</m_Name>
	<m_AnimName>Bob_FallLanding_HeavyFall</m_AnimName>
	<m_Priority>10</m_Priority>
	<m_ConditionPriority>10</m_ConditionPriority>
	<m_Looped>false</m_Looped>
	<m_BlendTime>0.05</m_BlendTime>
	<m_EarlyTransitionOut>true</m_EarlyTransitionOut>
	<m_SpeedScale>0.80</m_SpeedScale>
	<m_Conditions>
		<m_Name>StiltsActive</m_Name>
		<m_Type>BOOL</m_Type>
		<m_Value>true</m_Value>
	</m_Conditions>
	<m_Conditions>
		<m_Name>BumpDone</m_Name>
		<m_Type>BOOL</m_Type>
		<m_Value>false</m_Value>
	</m_Conditions>
	<m_Conditions>
		<m_Name>BumpFall</m_Name>
		<m_Type>BOOL</m_Type>
		<m_Value>true</m_Value>
	</m_Conditions>
	<m_Conditions>
		<m_Name>BumpFallType</m_Name>
		<m_Type>STRING</m_Type>
		<m_StringValue>pushedFront</m_StringValue>
	</m_Conditions>
	<m_Events>
		<m_EventName>FallOnFront</m_EventName>
		<m_TimePc>0.5</m_TimePc>
		<m_ParameterValue>true</m_ParameterValue>
	</m_Events>
	<m_Events>
		<m_EventName>SetVariable</m_EventName>
		<m_Time>End</m_Time>
		<m_ParameterValue>BumpFallAnimFinished=true</m_ParameterValue>
	</m_Events>
	<m_Events>
		<m_EventName>PlaySound</m_EventName>
		<m_TimePc>0.25</m_TimePc>
		<m_ParameterValue>LandHeavyFromFall</m_ParameterValue>
	</m_Events>
	<m_Events>
		<m_EventName>PlayerVoiceSound</m_EventName>
		<m_Time>Start</m_Time>
		<m_ParameterValue>PainFromFallHigh</m_ParameterValue>
	</m_Events>
</animNode>
